-- [[ SECTION 13: CORE ENGINE RENDERSTEPPED LOOP ]]
RunService.RenderStepped:Connect(function()
    local mousePosition = UserInputService:GetMouseLocation()

    -- FOV Update
    FOVCircleDrawing.Visible = SystemState.Aimbot.FOVCheck
    FOVCircleDrawing.Radius = SystemState.Aimbot.FOVRadius
    FOVCircleDrawing.Position = mousePosition

    -- Crosshair Update
    CrosshairLineX.Visible = SystemState.Aimbot.Crosshair
    CrosshairLineY.Visible = SystemState.Aimbot.Crosshair
    if SystemState.Aimbot.Crosshair then
        CrosshairLineX.From = Vector2.new(mousePosition.X - 8, mousePosition.Y)
        CrosshairLineX.To = Vector2.new(mousePosition.X + 8, mousePosition.Y)
        CrosshairLineY.From = Vector2.new(mousePosition.X, mousePosition.Y - 8)
        CrosshairLineY.To = Vector2.new(mousePosition.X, mousePosition.Y + 8)
    end

    -- Aimbot Exec
    if isAimingInputActive and SystemState.Aimbot.Enabled then
        local activeTarget = TargetSelector.GetClosestTarget()
        if activeTarget and activeTarget.Character and activeTarget.Character:FindFirstChild(SystemState.Aimbot.TargetPart) then
            local targetWorldPosition = activeTarget.Character[SystemState.Aimbot.TargetPart].Position
            if SystemState.Aimbot.Prediction then
                local targetVelocity = activeTarget.Character[SystemState.Aimbot.TargetPart].AssemblyLinearVelocity
                targetWorldPosition = targetWorldPosition + (targetVelocity * SystemState.Aimbot.Prediction)
            end
            local currentCameraCFrame = Camera.CFrame
            Camera.CFrame = currentCameraCFrame:Lerp(CFrame.new(currentCameraCFrame.Position, targetWorldPosition), SystemState.Aimbot.Smoothness)
        end
    end

    -- Movement Exec
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        humanoid.WalkSpeed = SystemState.Movement.SpeedHack and SystemState.Movement.WalkSpeed or 16
        humanoid.JumpPower = SystemState.Movement.JumpPowerHack and SystemState.Movement.JumpPower or 50
    end

    -- Noclip Exec
    if SystemState.Movement.Noclip and LocalPlayer.Character then
        for _, characterPart in pairs(LocalPlayer.Character:GetChildren()) do
            if characterPart:IsA("BasePart") then
                characterPart.CanCollide = false
            end
        end
    end

    -- World Exec
    if SystemState.World.FullBright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
    end

    if SystemState.World.NoFog then
        Lighting.FogEnd = 9e9
    end

    if SystemState.World.FOVChanger then
        Camera.FieldOfView = SystemState.World.FieldOfView
    end

    -- Visual ESP Pipeline
    for _, lineInstance in pairs(TracerLineCache) do
        lineInstance:Remove()
    end
    table.clear(TracerLineCache)

    for _, playerInstance in pairs(Players:GetPlayers()) do
        if playerInstance ~= LocalPlayer and playerInstance.Character and playerInstance.Character:FindFirstChild("HumanoidRootPart") then
            local targetChar = playerInstance.Character
            local rootPart = targetChar.HumanoidRootPart

            -- Highlight
            local highlightInstance = targetChar:FindFirstChild("RivalsHighlightInstance")
            if SystemState.Visuals.ESPHighlight then
                if not highlightInstance then
                    highlightInstance = Instance.new("Highlight")
                    highlightInstance.Name = "RivalsHighlightInstance"
                    highlightInstance.Parent = targetChar
                end
                highlightInstance.Enabled = true
                highlightInstance.FillColor = SystemState.Visuals.HighlightColor
            elseif highlightInstance then
                highlightInstance.Enabled = false
            end

            -- Billboard Tag ESP
            local billboardGui = rootPart:FindFirstChild("RivalsESPTag")
            if SystemState.Visuals.ESPNames or SystemState.Visuals.ESPDistance then
                if not billboardGui then
                    billboardGui = Instance.new("BillboardGui")
                    billboardGui.Name = "RivalsESPTag"
                    billboardGui.Size = UDim2.new(0, 200, 0, 40)
                    billboardGui.StudsOffset = Vector3.new(0, 3.2, 0)
                    billboardGui.AlwaysOnTop = true
                    billboardGui.Parent = rootPart

                    local tagLabel = Instance.new("TextLabel")
                    tagLabel.Name = "TagLabel"
                    tagLabel.Size = UDim2.new(1, 0, 1, 0)
                    tagLabel.BackgroundTransparency = 1
                    tagLabel.Font = Enum.Font.GothamBold
                    tagLabel.TextSize = 12
                    tagLabel.TextColor3 = Theme.TextActive
                    tagLabel.Parent = billboardGui
                end

                local labelTextString = ""
                if SystemState.Visuals.ESPNames then
                    labelTextString = labelTextString .. playerInstance.Name
                end
                if SystemState.Visuals.ESPDistance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local calculatedDistance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude)
                    labelTextString = labelTextString .. string.format("\n[%dm]", calculatedDistance)
                end

                billboardGui.TagLabel.Text = labelTextString
                billboardGui.Enabled = true
            elseif billboardGui then
                billboardGui.Enabled = false
            end

            -- Tracers
            if SystemState.Visuals.ESPTracers then
                local screenPoint, isVisibleOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
                if isVisibleOnScreen then
                    local tracerLine = Drawing.new("Line")
                    tracerLine.Visible = true
                    tracerLine.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracerLine.To = Vector2.new(screenPoint.X, screenPoint.Y)
                    tracerLine.Color = SystemState.Visuals.TracersColor
                    tracerLine.Thickness = 1.5
                    tracerLine.Transparency = 1
                    table.insert(TracerLineCache, tracerLine)
                end
            end
        end
    end
end)

