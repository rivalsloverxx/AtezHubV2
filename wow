-- [[ SECTION 11: ENGINE TARGETING ENGINE & RAYCAST PIPELINE ]]
local TargetSelector = {}

function TargetSelector.GetClosestTarget()
    local bestTarget = nil
    local maxDistance = SystemState.Aimbot.FOVCheck and SystemState.Aimbot.FOVRadius or math.huge
    local mouseLocation = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if SystemState.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then
                    continue
                end

                local targetPart = player.Character:FindFirstChild(SystemState.Aimbot.TargetPart)
                if targetPart then
                    local screenPosition, isOnScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if isOnScreen then
                        local screenDist = (Vector2.new(screenPosition.X, screenPosition.Y) - mouseLocation).Magnitude
                        if screenDist < maxDistance then
                            if SystemState.Aimbot.WallCheck then
                                local raycastParameters = RaycastParams.new()
                                raycastParameters.FilterType = Enum.RaycastFilterType.Exclude
                                raycastParameters.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
                                local raycastResult = workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, raycastParameters)

                                if raycastResult and raycastResult.Instance:IsDescendantOf(player.Character) then
                                    maxDistance = screenDist
                                    bestTarget = player
                                end
                            else
                                maxDistance = screenDist
                                bestTarget = player
                            end
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

